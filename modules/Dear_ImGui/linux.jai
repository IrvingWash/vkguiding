    return (fields.__bitfield & (1 << 0)) != 0;
}

set_reserved :: (fields: *StdVideoVP9ColorConfigFlags, value: u32) {
    MASK0: u32 : (0b111_1111_1111_1111_1111_1111_1111_1111 << 1);
    fields.__bitfield = (fields.__bitfield & ~MASK0) | ((value << 1) & MASK0);
}
